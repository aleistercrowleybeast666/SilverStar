    "name": "NOT_RUN",
    "value": 255,
    "meaning": "Only the old replay-result fields use this current-mode sentinel; never an execution result, acceptance or READY."
  },
  "timestamp_semantics": {
    "source": "Resolved common-SystemTime measurement epoch; zero and SOURCE_RESOLVED clear if not resolved.",
    "receive": "Original receive timestamp; never rewritten into a source timestamp.",
    "application": "Epoch of a numerical attempt when established. APPLICATION_EPOCH_VALID clear requires zero. Clear can mean not attempted or evidence unavailable, never proves no attempt.",
    "evaluation": "Estimator present epoch in the existing record field; output state and full covariance refer to estimator present.",
    "current": "Numerical admission requires resolved source <= receive <= estimator present and both ages <=500000 us. These are admission conditions, not requirements for every diagnostic record: STALE/INVALID and other ordinary rejection records preserve their actual input timestamps. Valid application equals estimator present; no history replay.",
    "legacy": "Preserve the original algorithm epoch. KF6 untrusted zero-delay overrides application to present, with separate resolved source=receive.",
    "flags": "TRUSTED_SOURCE and DELAY_FALLBACK are mutually exclusive resolver-method evidence. LEGACY_PRESENT_OVERRIDE is only KF6 mode 1 with untrusted zero-delay input.",
    "numeric_failure": "Legacy replay may fail during prediction without proving whether this observation was attempted; NUMERIC_ERROR plus application=0 is honest incomplete evidence."
  },
  "execution_semantics": {
    "COMPLETE": "Scheduling/numerical attempt completed; consult original update/NIS result for acceptance. Does not imply successful fusion, logger delivery or READY.",
    "NIS_rejection": "A completed NIS rejection can carry a valid application epoch; do not label it a numerical error.",
    "reserved": "Unknown mode/result/flag values and nonzero timing_reserved are invalid for this exact revision."
  },
  "identity_semantics": {
    "key": [
      "source_namespace",
      "source_id",
      "mission_epoch",
      "calibration_generation",
      "source_sequence",
      "group"
    ],
    "gnss": "source_id is the actual selected GNSS instance ordinal (zero is valid); source_sequence is the received GNSS packet sequence.",
    "kf6_epoch": "Use the original replay_epoch, which is the estimator mission/replay epoch. replay_generation is never calibration_generation.",
    "kf6_sequence": "Use the original sequence field, never receive/position/velocity operation_sequence or SSLOG header sequence.",
    "eskf_sequence": "Use appended source_sequence, never operation_sequence or SSLOG header sequence.",
    "barometer_current": "Canonical estimator barometer producer namespace, source_id=1. Sequence is the delivered producer sequence; cold failover can assign a logical sequence distinct from native physical samples.",
    "barometer_legacy_kf6": "Appended source_id=1 denotes the canonical estimator barometer producer; it does not establish physical sensor identity.",
    "barometer_legacy_eskf": "The preserved source_id prefix historically denotes the selected IMU source. It is not physical barometer identity and must not be reinterpreted.",
    "physical_barometer_limit": "No independent physical-instance/switch audit is claimed. Native-record association requires additional unambiguous recorded evidence; timestamp or sequence equality alone is insufficient across instances.",
    "generation": "Recorded estimator calibration generation, not a native sensor calibration claim.",
    "source_unavailable": "Do not invent a physical identity. Unavailable source identity must prevent an exact-current replay claim."
  },
