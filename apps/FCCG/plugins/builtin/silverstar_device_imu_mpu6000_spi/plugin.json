        "electrical_constraints": {
          "mode": "gpio_interrupt",
          "pull": "none",
          "exti_trigger": "rising",
          "irq": true,
          "maximum_irq_priority": 5
        }
      },
      {
        "name": "time",
        "kind": "time",
        "mode": "shared"
      }
