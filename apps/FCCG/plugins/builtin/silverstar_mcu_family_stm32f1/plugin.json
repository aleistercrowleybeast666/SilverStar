        "provider_sources": [
          "Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_dma.c"
        ],
        "middleware_sources": [],
        "include_dirs": [],
        "defines": [],
        "capabilities": [
          "hal.dma"
