      "uart": {
        "inventory_modules": [
          "USART*",
          "UART*",
          "LPUART*"
        ],
        "init_sources": [
          "Core/Src/usart.c"
        ],
        "provider_sources": [
          "Drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_uart.c"
