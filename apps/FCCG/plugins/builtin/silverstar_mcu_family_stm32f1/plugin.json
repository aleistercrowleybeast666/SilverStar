        "sources": [
          "Platform/STM32F1/Src/platform_gpio_stm32f1.c"
        ],
        "provider_sources": [],
        "include_dirs": [],
        "defines": [],
        "capabilities": [
          "gpio.digital",
          "gpio.exti"
        ],
        "ownership": "single_owner"
      },
      "time": {
        "maturity": "supported",
        "inventory_kinds": [
          "time"
