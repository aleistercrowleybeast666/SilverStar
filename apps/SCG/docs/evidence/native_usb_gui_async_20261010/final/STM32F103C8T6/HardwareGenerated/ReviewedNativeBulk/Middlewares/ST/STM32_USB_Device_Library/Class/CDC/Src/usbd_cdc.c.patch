+  USBD_CDC_HandleTypeDef *hcdc;
+  USBD_CDC_ItfTypeDef *itf;
+  if ((pdev == NULL) || (pdev->dev_speed != USBD_SPEED_FULL) ||
+      (pdev->pUserData == NULL) || (pdev->pClassData != NULL)) { return USBD_FAIL; }
+  itf = (USBD_CDC_ItfTypeDef *)pdev->pUserData;
