+      (pdev->ep_in[CDC_IN_EP & 0x0FU].is_used != 0U) ||
+      (pdev->ep_out[CDC_OUT_EP & 0x0FU].is_used != 0U) ||
+      (pdev->ep_in[CDC_CMD_EP & 0x0FU].is_used != 0U)) { return USBD_FAIL; }
