+  if (USBD_LL_PrepareReceive(pdev, CDC_OUT_EP, hcdc->RxBuffer, CDC_DATA_FS_OUT_PACKET_SIZE) != USBD_OK)
+  { return NativeCdc_InitAbort(pdev, cfgidx); }
+  return USBD_OK;
