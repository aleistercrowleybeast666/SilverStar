########################################################################################################################
# SilverStar authoritative build entry - generated by SilverStar_FCCG
########################################################################################################################

TARGET_PROFILE ?= SilverStar_F407
CONFIG ?= Release
MEMORY_LAYOUT ?= legacy
PYTHON ?= python

ifneq ($(MEMORY_LAYOUT),legacy)
ifneq ($(MEMORY_LAYOUT),eskf_window_sram)
ifneq ($(MEMORY_LAYOUT),auto)
$(error Unsupported MEMORY_LAYOUT '$(MEMORY_LAYOUT)'; expected legacy, eskf_window_sram or auto)
endif
endif
endif

SUPPORTED_TARGETS := SilverStar_F407
SUPPORTED_CONFIGS := Debug Release

ifeq ($(filter $(TARGET_PROFILE),$(SUPPORTED_TARGETS)),)
$(error Unsupported TARGET_PROFILE '$(TARGET_PROFILE)'; expected one of: $(SUPPORTED_TARGETS))
endif
ifeq ($(filter $(CONFIG),$(SUPPORTED_CONFIGS)),)
$(error Unsupported CONFIG '$(CONFIG)'; expected one of: $(SUPPORTED_CONFIGS))
endif

TARGET := SilverStar_0_1_3
BUILD_ROOT := build/FCCG/$(TARGET_PROFILE)/$(CONFIG)
ANALYZE ?= 0
ifeq ($(ANALYZE),1)
BUILD_ROOT := build/FCCG/$(TARGET_PROFILE)/StaticAnalysis/$(CONFIG)
endif
ifneq ($(MEMORY_LAYOUT),legacy)
BUILD_ROOT := $(BUILD_ROOT)/$(MEMORY_LAYOUT)
endif
LISTING ?= 0

C_SOURCES :=
ASM_SOURCES :=
C_INCLUDES :=
C_DEFS :=
TARGET_FORCED_INCLUDES :=
BUILD_MANIFESTS := Makefile

include Targets/$(TARGET_PROFILE)/target.mk
include Generated/project_sources.mk

ifeq ($(MEMORY_LAYOUT),eskf_window_sram)
ifneq ($(TARGET_PROFILE),SilverStar_F407)
$(error MEMORY_LAYOUT=eskf_window_sram requires SilverStar_F407 and the ESKF15 backend)
endif
ifeq ($(filter Algorithm/Estimator/ESKF15/Src/navigation_eskf_backend.c,$(C_SOURCES)),)
$(error MEMORY_LAYOUT=eskf_window_sram requires SilverStar_F407 and the ESKF15 backend)
endif
C_DEFS += SILVERSTAR_MEMORY_LAYOUT_ESKF_WINDOW_SRAM=1
endif

ifeq ($(MEMORY_LAYOUT),auto)
C_DEFS += SILVERSTAR_MEMORY_LAYOUT_AUTO=1
BUILD_MANIFESTS += Tools/auto_memory_layout.py
BUILD_MANIFESTS += Generated/memory_audit.py
endif

FIRST_PARTY_C_SOURCES := $(filter APP/% Algorithm/% Board/% Common/% Devices/% FlightLogic/% Generated/% Interfaces/% Modules/% OS/FreeRTOS/% Platform/% Protocol/% System/% Targets/%,$(C_SOURCES))
THIRD_PARTY_C_SOURCES := $(filter ThirdParty/% Middlewares/Third_Party/%,$(C_SOURCES))
VENDOR_C_SOURCES := $(filter Core/% Drivers/% FATFS/% HardwareGenerated/%,$(C_SOURCES))
CLASSIFIED_C_SOURCES := $(FIRST_PARTY_C_SOURCES) $(THIRD_PARTY_C_SOURCES) $(VENDOR_C_SOURCES)

ifneq ($(words $(C_SOURCES)),$(words $(CLASSIFIED_C_SOURCES)))
$(error The compiler policy does not classify every C source)
endif

ifneq ($(words $(C_SOURCES)),$(words $(sort $(C_SOURCES))))
$(error Duplicate C source detected in authoritative manifests)
endif
ifneq ($(words $(ASM_SOURCES)),$(words $(sort $(ASM_SOURCES))))
$(error Duplicate assembler source detected in authoritative manifests)
endif

ifdef GCC_PATH
CC := "$(GCC_PATH)/$(TOOLCHAIN_PREFIX)gcc"
AS := "$(GCC_PATH)/$(TOOLCHAIN_PREFIX)gcc" -x assembler-with-cpp
CP := "$(GCC_PATH)/$(TOOLCHAIN_PREFIX)objcopy"
SZ := "$(GCC_PATH)/$(TOOLCHAIN_PREFIX)size"
else
CC := $(TOOLCHAIN_PREFIX)gcc
AS := $(TOOLCHAIN_PREFIX)gcc -x assembler-with-cpp
CP := $(TOOLCHAIN_PREFIX)objcopy
SZ := $(TOOLCHAIN_PREFIX)size
endif

HEX := $(CP) -O ihex
BIN := $(CP) -O binary -S
MCU := $(TARGET_MCU_FLAGS)

ifeq ($(CONFIG),Debug)
OPT := -Og
DEBUG_FLAGS := -g3 -gdwarf-2
else ifeq ($(CONFIG),Release)
OPT := -O2
DEBUG_FLAGS := -g
else
$(error CONFIG must be Debug or Release)
endif

FIRST_PARTY_WARNINGS := -Wall -Wextra -Wpedantic -Werror \
                        -Wconversion -Wsign-conversion -Wshadow -Wundef \
                        -Wformat=2 -Wdouble-promotion -Wcast-align \
                        -Wcast-qual -Wstrict-prototypes \
                        -Wmissing-prototypes -Wswitch-enum -Wvla
ifeq ($(ANALYZE),1)
FIRST_PARTY_WARNINGS += -fanalyzer
endif
VENDOR_WARNINGS := -Wall -Werror=implicit-function-declaration \
                   -Werror=incompatible-pointer-types -Werror=return-type
THIRD_PARTY_WARNINGS := $(VENDOR_WARNINGS)
SECTION_FLAGS := -fdata-sections -ffunction-sections
INCLUDE_FLAGS := $(addprefix -I,$(C_INCLUDES))
DEFINE_FLAGS := $(addprefix -D,$(C_DEFS))
FORCED_INCLUDE_FLAGS := $(addprefix -include ,$(TARGET_FORCED_INCLUDES))

ASFLAGS := $(MCU) $(INCLUDE_FLAGS) $(OPT) $(DEBUG_FLAGS) -Wall $(SECTION_FLAGS)
CFLAGS := $(MCU) $(DEFINE_FLAGS) $(INCLUDE_FLAGS) $(OPT) $(DEBUG_FLAGS) \
          $(FORCED_INCLUDE_FLAGS) -std=c11 $(SECTION_FLAGS) -MMD -MP -fstack-usage
ifeq ($(LISTING),1)
LISTING_FLAGS = -Wa,-a,-ad,-alms=$(BUILD_ROOT)/$*.lst
else
LISTING_FLAGS =
endif

LDSCRIPT := $(TARGET_LDSCRIPT)
LDFLAGS := $(MCU) $(TARGET_SPECS) -T$(LDSCRIPT) $(TARGET_LIBS) \
           -Wl,-Map=$(BUILD_ROOT)/$(TARGET).map,--cref -Wl,--gc-sections

C_OBJECTS := $(addprefix $(BUILD_ROOT)/,$(C_SOURCES:.c=.o))
ASM_OBJECTS := $(addprefix $(BUILD_ROOT)/,$(ASM_SOURCES:.s=.o))
FIRST_PARTY_C_OBJECTS := $(addprefix $(BUILD_ROOT)/,$(FIRST_PARTY_C_SOURCES:.c=.o))
THIRD_PARTY_C_OBJECTS := $(addprefix $(BUILD_ROOT)/,$(THIRD_PARTY_C_SOURCES:.c=.o))
VENDOR_C_OBJECTS := $(addprefix $(BUILD_ROOT)/,$(VENDOR_C_SOURCES:.c=.o))
OBJECTS := $(C_OBJECTS) $(ASM_OBJECTS)
DEPENDENCIES := $(C_OBJECTS:.o=.d)

$(FIRST_PARTY_C_OBJECTS): SOURCE_WARNINGS := $(FIRST_PARTY_WARNINGS)
$(THIRD_PARTY_C_OBJECTS): SOURCE_WARNINGS := $(THIRD_PARTY_WARNINGS)
$(VENDOR_C_OBJECTS): SOURCE_WARNINGS := $(VENDOR_WARNINGS)

.PHONY: all clean clean-all rebuild list-sources list-build-config host-tests architecture-check power10-check static-analysis artifact-check memory-report stack-report

# FCCG cleanup contract: determinate-v1

all: $(BUILD_ROOT)/$(TARGET).elf $(BUILD_ROOT)/$(TARGET).hex $(BUILD_ROOT)/$(TARGET).bin

$(BUILD_ROOT)/%.o: %.c $(BUILD_MANIFESTS)
	@powershell -NoProfile -Command "New-Item -ItemType Directory -Force -Path '$(@D)' | Out-Null"
	@echo "FCCG_PROGRESS|COMPILE_BEGIN|$<"
	$(CC) -c $(CFLAGS) $(SOURCE_WARNINGS) -MF"$(@:.o=.d)" $(LISTING_FLAGS) $< -o $@
	@echo "FCCG_PROGRESS|COMPILE_DONE|$<"

$(BUILD_ROOT)/%.o: %.s $(BUILD_MANIFESTS)
	@powershell -NoProfile -Command "New-Item -ItemType Directory -Force -Path '$(@D)' | Out-Null"
	@echo "FCCG_PROGRESS|COMPILE_BEGIN|$<"
	$(AS) -c $(ASFLAGS) $< -o $@
	@echo "FCCG_PROGRESS|COMPILE_DONE|$<"

$(BUILD_ROOT)/$(TARGET).elf: $(OBJECTS) $(LDSCRIPT)
	@echo "FCCG_PROGRESS|LINK_BEGIN|$@"
ifeq ($(MEMORY_LAYOUT),auto)
	$(PYTHON) Tools/auto_memory_layout.py --linker $(LDSCRIPT) --output $@ --compiler $(CC) --objdump "$(if $(GCC_PATH),$(GCC_PATH)/,)$(TOOLCHAIN_PREFIX)objdump" -- $(OBJECTS) $(filter-out -T$(LDSCRIPT),$(LDFLAGS))
else
	$(CC) $(OBJECTS) $(LDFLAGS) -o $@
endif
	@echo "FCCG_PROGRESS|LINK_DONE|$@"
	@echo "FCCG_PROGRESS|SIZE_BEGIN|$@"
	$(SZ) $@
	@echo "FCCG_PROGRESS|SIZE_DONE|$@"

$(BUILD_ROOT)/%.hex: $(BUILD_ROOT)/%.elf
	@echo "FCCG_PROGRESS|HEX_BEGIN|$@"
	$(HEX) $< $@
	@echo "FCCG_PROGRESS|HEX_DONE|$@"

$(BUILD_ROOT)/%.bin: $(BUILD_ROOT)/%.elf
	@echo "FCCG_PROGRESS|BIN_BEGIN|$@"
	$(BIN) $< $@
	@echo "FCCG_PROGRESS|BIN_DONE|$@"

clean:
	@echo "FCCG_PROGRESS|CLEAN|PLAN|1"
	@echo "FCCG_PROGRESS|CLEAN|BEGIN|1|1|build/FCCG"
	powershell -NoProfile -Command "if (Test-Path -LiteralPath 'build/FCCG') { Remove-Item -LiteralPath 'build/FCCG' -Recurse -Force -ErrorAction Stop }"
	@echo "FCCG_PROGRESS|CLEAN|DONE|1|1|build/FCCG"

clean-all:
	@echo "FCCG_PROGRESS|CLEAN_ALL|PLAN|3"
	@echo "FCCG_PROGRESS|CLEAN_ALL|BEGIN|1|3|build/FCCG"
	powershell -NoProfile -Command "if (Test-Path -LiteralPath 'build/FCCG') { Remove-Item -LiteralPath 'build/FCCG' -Recurse -Force -ErrorAction Stop }"
	@echo "FCCG_PROGRESS|CLEAN_ALL|DONE|1|3|build/FCCG"
	@echo "FCCG_PROGRESS|CLEAN_ALL|BEGIN|2|3|.eide/build"
	powershell -NoProfile -Command "if (Test-Path -LiteralPath '.eide/build') { Remove-Item -LiteralPath '.eide/build' -Recurse -Force -ErrorAction Stop }"
	@echo "FCCG_PROGRESS|CLEAN_ALL|DONE|2|3|.eide/build"
	@echo "FCCG_PROGRESS|CLEAN_ALL|BEGIN|3|3|.eide/.cache"
	powershell -NoProfile -Command "if (Test-Path -LiteralPath '.eide/.cache') { Remove-Item -LiteralPath '.eide/.cache' -Recurse -Force -ErrorAction Stop }"
	@echo "FCCG_PROGRESS|CLEAN_ALL|DONE|3|3|.eide/.cache"

rebuild: clean all

list-sources:
	@$(foreach source,$(C_SOURCES),echo $(source) & ) echo Assembly: $(ASM_SOURCES)

list-build-config:
	@echo MEMORY_LAYOUT:$(MEMORY_LAYOUT)
	@$(foreach include,$(C_INCLUDES),echo INCLUDE:$(include) & ) echo CONFIG-INCLUDES-END
	@$(foreach define,$(C_DEFS),echo DEFINE:$(define) & ) echo CONFIG-DEFINES-END

stack-report: all
	python Tools/check_task_stacks.py --config $(CONFIG) --memory-layout $(MEMORY_LAYOUT) --prefix "$(if $(GCC_PATH),$(GCC_PATH)/,)$(TOOLCHAIN_PREFIX)"

HOST_CC ?= gcc
host-tests:
	powershell -NoProfile -ExecutionPolicy Bypass -File Tests/Host/run_tests.ps1 -HostCompiler "$(HOST_CC)"

architecture-check:
	powershell -NoProfile -ExecutionPolicy Bypass -File Tools/check_architecture.ps1

power10-check:
	powershell -NoProfile -ExecutionPolicy Bypass -File Tools/check_power_of_ten.ps1

static-analysis:
	$(MAKE) TARGET_PROFILE=$(TARGET_PROFILE) CONFIG=$(CONFIG) ANALYZE=1 all

artifact-check: all
	powershell -NoProfile -ExecutionPolicy Bypass -File Tools/check_firmware_artifact.ps1 -TargetProfile $(TARGET_PROFILE) -Config $(CONFIG) $(if $(filter legacy,$(MEMORY_LAYOUT)),,-MemoryLayout $(MEMORY_LAYOUT))

memory-report: artifact-check

-include $(DEPENDENCIES)
