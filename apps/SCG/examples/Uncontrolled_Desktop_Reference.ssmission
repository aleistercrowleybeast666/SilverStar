  "process": {
    "schema_version": 1,
    "execution": "desktop_reference",
    "start_policy": "separate",
    "maximum_gap_ms": 1000,
    "stages": [
      {
        "stage_id": "ready",
        "name": "就绪",
        "condition": {
          "signal": "event",
          "operator": "is",
          "value": "ready",
          "unit": "event_id"
        },
        "hold_ms": 0,
        "action": {
          "kind": "record_marker",
          "target": ""
        }
      },
      {
        "stage_id": "mission_start",
        "name": "任务开始",
        "condition": {
          "signal": "event",
          "operator": "is",
          "value": "start_accepted",
          "unit": "event_id"
        },
        "hold_ms": 0,
        "action": {
          "kind": "record_marker",
          "target": ""
        }
      },
      {
        "stage_id": "ascent",
        "name": "动力上升",
        "condition": {
          "signal": "event",
          "operator": "is",
          "value": "launch_detected",
          "unit": "event_id"
        },
        "hold_ms": 0,
        "action": {
          "kind": "record_marker",
          "target": ""
        }
      },
      {
        "stage_id": "coast",
        "name": "无动力滑行",
        "condition": {
          "signal": "event",
          "operator": "is",
          "value": "burnout_detected",
          "unit": "event_id"
        },
        "hold_ms": 0,
        "action": {
          "kind": "record_marker",
          "target": ""
        }
      },
      {
        "stage_id": "predeploy",
        "name": "预开伞",
        "condition": {
          "signal": "event",
          "operator": "is",
          "value": "apogee_confirmed",
          "unit": "event_id"
        },
        "hold_ms": 0,
        "action": {
          "kind": "record_marker",
          "target": ""
        }
      },
      {
        "stage_id": "deploy",
        "name": "开伞请求",
        "condition": {
          "signal": "stage_elapsed_s",
          "operator": ">=",
          "value": 0.0,
          "unit": "s"
        },
        "hold_ms": 0,
        "action": {
          "kind": "request_recovery",
          "target": "parachute_pyro0"
        }
      },
      {
        "stage_id": "descent",
        "name": "下降",
        "condition": {
          "signal": "event",
          "operator": "is",
          "value": "deployment_confirmed",
          "unit": "event_id"
        },
        "hold_ms": 0,
        "action": {
          "kind": "record_marker",
          "target": ""
        }
      },
      {
        "stage_id": "landed",
        "name": "已落地",
        "condition": {
          "signal": "event",
          "operator": "is",
          "value": "landed_confirmed",
          "unit": "event_id"
        },
        "hold_ms": 0,
        "action": {
          "kind": "record_marker",
          "target": ""
        }
      },
      {
        "stage_id": "recovery",
        "name": "地面找回",
        "condition": {
          "signal": "event",
          "operator": "is",
          "value": "recovery_complete",
          "unit": "event_id"
        },
        "hold_ms": 0,
        "action": {
          "kind": "record_marker",
          "target": ""
        }
      }
    ]
  },
