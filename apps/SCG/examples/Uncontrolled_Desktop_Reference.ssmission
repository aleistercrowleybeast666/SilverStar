  "rules": [
    {
      "owner": {
        "plugin_id": "silverstar.flight_logic.deployment.multi_trigger",
        "version": "0.1.0"
      },
      "slot": "deployment",
      "option": "ApogeeVerticalVelocity",
      "enabled": true,
      "parameters": [
        {
          "id": "vertical_velocity_threshold",
          "type": "float",
          "value": -2.0,
          "unit": "m/s",
          "minimum": -100.0,
          "maximum": -0.01,
          "generated_symbol": "SYSTEM_FLIGHT_APOGEE_VZ_THRESHOLD_MPS",
          "generated_scale": 1.0
        }
      ]
    },
    {
      "owner": {
        "plugin_id": "silverstar.flight_logic.deployment.multi_trigger",
        "version": "0.1.0"
      },
      "slot": "deployment",
      "option": "Tilt",
      "enabled": true,
      "parameters": [
        {
          "id": "tilt_threshold",
          "type": "float",
          "value": 45.0,
          "unit": "°",
          "minimum": 0.01,
          "maximum": 180.0,
          "generated_symbol": "SYSTEM_FLIGHT_TILT_THRESHOLD_DEG",
          "generated_scale": 1.0
