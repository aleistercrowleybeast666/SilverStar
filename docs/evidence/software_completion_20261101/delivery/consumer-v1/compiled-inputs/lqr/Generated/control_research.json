{
  "schema_id": "silverstar.control-research-runtime/1",
  "enabled": true,
  "binding": {
    "instance_id": "controller",
    "plugin_id": "silverstar.algorithm.control.lqr",
    "category": "control",
    "execution": "continuous",
    "start": {
      "kind": "mission_start",
      "stage_id": ""
    },
    "stop": {
      "kind": "system_landed",
      "stage_id": ""
    },
    "depends_on": [
      "estimator"
    ],
    "input_bindings": {},
    "output": "control.research.command"
  },
  "kind": "lqr",
  "period_us": 10000,
  "maximum_lateness_us": 2000,
  "maximum_input_age_us": 20000,
  "maximum_input_skew_us": 10000,
  "input": "ENU body+Z Hamilton wxyz q_nb; atan2(axis_x,axis_z) rad and calibrated body-Y gyro rad/s",
  "domain": "planar body-Y small-angle: |pitch|<=0.35 rad; |qx|,|qz|<=0.01; |rate|<=20 rad/s",
  "reference_rad": 0,
  "sink": "one bounded latest body-Y torque request snapshot; no actuator driver",
  "output": {
    "quantity": "requested_body_y_torque",
    "axis": "body-Y",
    "unit": "N*m",
    "nm_per_core_output_unit": 1.0,
    "maximum_absolute_torque_nm": 1.0
  },
  "electrical_output": false,
  "deployable": false,
  "failure": "withdraw publication, stop once, latch failure, ordinary lifecycle FAULT; no restart in mission",
  "timing": "nominal discrete 10 ms, <=2 ms polling lateness; no catch-up execution; hardware WCET unproven"
}
