-  pdev->pClass->DeInit(pdev, cfgidx);
-
-  return USBD_OK;
+USBD_StatusTypeDef USBD_ClrClassConfig(USBD_HandleTypeDef *pdev, uint8_t cfgidx)
+{
+  UsbCdc_LinkDown();
+  if ((pdev != &hUsbDeviceFS) || (pdev->pClass == NULL) ||
+      (pdev->pClass->DeInit == NULL)) { return USBD_FAIL; }
+  return (pdev->pClass->DeInit(pdev, cfgidx) == USBD_OK) ? USBD_OK : USBD_FAIL;
 }
 
 
@@ -260,34 +259,38 @@
 * @param  pdev: device instance
 * @retval status
 */
-USBD_StatusTypeDef USBD_LL_SetupStage(USBD_HandleTypeDef *pdev, uint8_t *psetup)
-{
-  USBD_ParseSetupRequest(&pdev->request, psetup);
-
-  pdev->ep0_state = USBD_EP0_SETUP;
-
-  pdev->ep0_data_len = pdev->request.wLength;
-
-  switch (pdev->request.bmRequest & 0x1FU)
-  {
-    case USB_REQ_RECIPIENT_DEVICE:
-      USBD_StdDevReq(pdev, &pdev->request);
-      break;
-
-    case USB_REQ_RECIPIENT_INTERFACE:
-      USBD_StdItfReq(pdev, &pdev->request);
-      break;
-
-    case USB_REQ_RECIPIENT_ENDPOINT:
-      USBD_StdEPReq(pdev, &pdev->request);
-      break;
-
-    default:
-      USBD_LL_StallEP(pdev, (pdev->request.bmRequest & 0x80U));
-      break;
-  }
-
-  return USBD_OK;
+USBD_StatusTypeDef USBD_LL_SetupStage(USBD_HandleTypeDef *pdev, uint8_t *psetup)
+{
+  if (pdev != &hUsbDeviceFS) { return USBD_FAIL; }
+  USBD_ParseSetupRequest(&pdev->request, psetup);
+
+  pdev->ep0_state = USBD_EP0_SETUP;
+
+  pdev->ep0_data_len = pdev->request.wLength;
+  PcUsbControl_Cancel(pdev);
+  if ((pdev->request.bmRequest & USB_REQ_TYPE_MASK) == USB_REQ_TYPE_CLASS)
+  { return PcUsbControl_Dispatch(pdev); }
+
+  switch (pdev->request.bmRequest & 0x1FU)
+  {
+    case USB_REQ_RECIPIENT_DEVICE:
+      USBD_StdDevReq(pdev, &pdev->request);
+      break;
+
+    case USB_REQ_RECIPIENT_INTERFACE:
+      USBD_StdItfReq(pdev, &pdev->request);
+      break;
+
+    case USB_REQ_RECIPIENT_ENDPOINT:
+      USBD_StdEPReq(pdev, &pdev->request);
+      break;
+
+    default:
+      USBD_LL_StallEP(pdev, (pdev->request.bmRequest & 0x80U));
+      break;
+  }
+
+  return (pdev->ep0_state == USBD_EP0_STALL) ? USBD_FAIL : USBD_OK;
 }
 
