-USBD_StatusTypeDef USBD_SetClassConfig(USBD_HandleTypeDef  *pdev, uint8_t cfgidx)
-{
-  USBD_StatusTypeDef ret = USBD_FAIL;
-
-  if (pdev->pClass != NULL)
