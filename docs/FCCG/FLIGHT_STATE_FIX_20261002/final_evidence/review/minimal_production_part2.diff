-    if ((isfinite(value) == 0) || (value < 0.0f)) { return UINT16_MAX; }
-    value *= 256.0f;
-    return (value >= (float)UINT16_MAX) ? (UINT16_MAX - 1U) : (uint16_t)value;
-}
