+    char *destination = NULL;
+    if ((field == NULL) || (identity == NULL))
+    { return GnssNeoM9nIdentityBadLength; }
+    for (length = 0U; length < GNSS_MON_VER_FIELD_LEN; length++)
+    { if (field[length] == 0U) { break; } }
