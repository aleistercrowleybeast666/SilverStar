+#if (PLATFORM_UART_FIRST_READ_TRACE_ENABLE != 0U)
+/* HAL tick is ISR-safe; offsets are DMA-observation time, not wire-byte time. */
+static volatile PlatformUartFirstReadTrace s_first_read_trace;
+_Static_assert(sizeof(PlatformUartFirstReadTrace) <= 2048U,
+    "First-read diagnostic trace exceeds its authorized 2 KiB bound");
+
+static uint8_t PlatformUart_FirstReadTraceMatches(PlatformUartContext *context)
+{
+    return (uint8_t)((s_first_read_trace.armed != 0U) &&
+        (s_first_read_trace.frozen == 0U) &&
+        (s_first_read_trace.uart < PLATFORM_UART_COUNT) &&
+        (context == &s_uart[s_first_read_trace.uart]));
+}
+
+static void PlatformUart_FirstReadTraceRecord(uint8_t kind,
+    uint32_t detail, const uint8_t *bytes, uint8_t length)
+{
+    uint16_t slot;
+    uint8_t index;
+    uint8_t sum = 0U;
+
+    SILVERSTAR_ASSERT(s_first_read_trace.event_count <=
+        PLATFORM_UART_FIRST_READ_TRACE_EVENTS,
+        SILVERSTAR_ASSERT_MODULE_PLATFORM,
+        SILVERSTAR_ASSERT_REASON_BUFFER_CAPACITY);
+    if (s_first_read_trace.event_count == PLATFORM_UART_FIRST_READ_TRACE_EVENTS)
+    {
+        if (s_first_read_trace.dropped_events < UINT32_MAX)
+        { s_first_read_trace.dropped_events++; }
+        return;
+    }
+    slot = s_first_read_trace.event_count;
+    s_first_read_trace.events[slot].offset_ms =
+        PlatformTime_Ms() - s_first_read_trace.started_ms;
+    s_first_read_trace.events[slot].kind = kind;
+    s_first_read_trace.events[slot].detail = detail;
+    for (index = 0U; index < 11U; index++)
+    {
+        uint8_t byte = ((bytes != NULL) && (index < length)) ? bytes[index] : 0U;
+        s_first_read_trace.events[slot].bytes[index] = byte;
+        if (index < 10U) { sum = (uint8_t)(sum + byte); }
+    }
+    s_first_read_trace.events[slot].checksum_valid = (uint8_t)(
+        (length == 11U) && (sum == s_first_read_trace.events[slot].bytes[10]));
+    s_first_read_trace.event_count++;
+}
+
+void PlatformUart_FirstReadTraceBegin(PlatformUartId id, uint8_t reg)
+{
+    PlatformCriticalState state = PlatformCritical_Enter();
+
+    if ((id < PLATFORM_UART_COUNT) && (s_first_read_trace.armed == 0U))
+    {
+        s_first_read_trace.started_ms = PlatformTime_Ms();
+        s_first_read_trace.uart = (uint8_t)id;
+        s_first_read_trace.reg = reg;
+        s_first_read_trace.armed = 1U;
+        PlatformUart_FirstReadTraceRecord(PlatformUartFirstReadTrace_Begin,
+            reg, NULL, 0U);
+    }
+    PlatformCritical_Exit(state);
+}
+
+void PlatformUart_FirstReadTraceResult(PlatformUartId id,
+    uint8_t phase, uint8_t result, uint8_t finished)
+{
+    PlatformCriticalState state = PlatformCritical_Enter();
+
+    if ((id < PLATFORM_UART_COUNT) &&
+        (PlatformUart_FirstReadTraceMatches(&s_uart[id]) != 0U))
+    {
+        s_first_read_trace.last_phase = phase;
+        s_first_read_trace.last_result = result;
+        if (phase == 2U) { s_first_read_trace.poll_count++; }
+        /* Pending polls update counters instead of filling the event array. */
+        if ((phase != 2U) || (finished != 0U))
+        {
+            PlatformUart_FirstReadTraceRecord((phase == 2U) ?
+                PlatformUartFirstReadTrace_PollResult :
+                PlatformUartFirstReadTrace_StartResult, result, NULL, 0U);
+        }
+        if (finished != 0U)
+        {
+            s_first_read_trace.finished_offset_ms =
+                PlatformTime_Ms() - s_first_read_trace.started_ms;
+            s_first_read_trace.frozen = 1U;
+        }
+    }
+    PlatformCritical_Exit(state);
+}
+
+static void PlatformUart_FirstReadTraceObserve(PlatformUartContext *context,
+    const uint8_t *data, uint16_t length)
+{
+    uint16_t index;
+    uint8_t position;
+    uint8_t next;
+    uint8_t frame[11];
+
+    if (PlatformUart_FirstReadTraceMatches(context) == 0U) { return; }
+    SILVERSTAR_ASSERT((s_first_read_trace.window_position < 11U) &&
+        (s_first_read_trace.window_count <= 11U),
+        SILVERSTAR_ASSERT_MODULE_PLATFORM,
+        SILVERSTAR_ASSERT_REASON_BUFFER_CAPACITY);
+    for (index = 0U; index < length; index++)
+    {
+        position = s_first_read_trace.window_position;
+        s_first_read_trace.window[position] = data[index];
+        position = (uint8_t)((position + 1U) % 11U);
+        s_first_read_trace.window_position = position;
+        if (s_first_read_trace.window_count < 11U)
+        { s_first_read_trace.window_count++; }
+        if ((s_first_read_trace.window_count == 11U) &&
+            (s_first_read_trace.window[position] == 0x55U) &&
+            (s_first_read_trace.window[(position + 1U) % 11U] == 0x5FU))
+        {
+            for (next = 0U; next < 11U; next++)
+            { frame[next] = s_first_read_trace.window[(position + next) % 11U]; }
+            PlatformUart_FirstReadTraceRecord(PlatformUartFirstReadTrace_RxCandidate,
+                s_first_read_trace.observed_rx_bytes + index + 1U, frame, 11U);
+        }
+    }
+    s_first_read_trace.observed_rx_bytes += length;
+}
