diff --git a/apps/FCCG/plugins/builtin/silverstar_core_0_1_0/payload/Tools/read_firmware_identity.ps1 b/apps/FCCG/plugins/builtin/silverstar_core_0_1_0/payload/Tools/read_firmware_identity.ps1
