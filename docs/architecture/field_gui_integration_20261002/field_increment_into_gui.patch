+static uint32_t Lora_RxGrantMs(uint8_t instance)
+{
+    uint32_t minimum = Lora_PacketAirtimeMs(instance, LORA_MAX_PAYLOAD_LEN) + LORA_RX_TURN_MARGIN_MS;
+    return (minimum > LORA_RX_DWELL_MS) ? minimum : LORA_RX_DWELL_MS;
+}
