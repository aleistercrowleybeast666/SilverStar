{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:silverstar:session-export:1",
  "title": "SilverStar session export manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format", "session_id", "created_at", "source_app", "protocols", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "format": {"const": "silverstar.session-export"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "source_app": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "protocols": {"type": "object", "additionalProperties": {"type": ["string", "integer", "null"]}},
    "files": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "role", "format", "format_version", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"},
        "role": {"enum": ["session_log", "flight_log", "decoder", "descriptor", "attachment"]},
        "format": {"type": "string", "minLength": 1, "maxLength": 80},
        "format_version": {"type": "string", "minLength": 1, "maxLength": 40},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }}
  },
  "$comment": "manifest.json at directory-package or ZIP root. File bytes immutable; relative paths unique after case-folding; reject symlinks, path traversal, duplicate entries and undeclared payload files. SHA256 is over original uncompressed bytes. No implicit source deletion. GSHC JSONL new SESSION_START: log_format=silverstar.gshc-jsonl, log_format_version=1; old sessions use format_version=legacy-unversioned and are copied unchanged. SSLOG format_version=0.0. Exact .ssdecoder identity must be verified by existing FLP coordinator; adding a decoder file never establishes a match."
}
