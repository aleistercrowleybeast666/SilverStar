    "late": 13,
    "model_mismatch": 14,
    "busy": 15
  },
  "frozen_predecessor": "contracts/navigation_fusion_timing_records_v2.json",
  "prepared_variance": "Exact binary32 variance passed to the numerical update before NIS/robust weighting. Quality and consistency scales are already applied; never multiply them again for Recorded replay.",
  "kf_receive_certificate": "Immutable once-per-physical-receipt NavigationReplayGroupEvidence plus consistency_valid. Copy to the delayed KF group at source-time application; do not reconstruct its counters from application order. All eight fields are zero for ESKF15 and barometer groups."
